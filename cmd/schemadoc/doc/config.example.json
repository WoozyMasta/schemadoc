{
  "check": false,
  "merge": {
    "imports": [
      {
        "conflict": "error",
        "file": "schemas/common.schema.json",
        "rename": {
          "mode": "none",
          "value": "model_"
        },
        "source_defs": "/components/schemas",
        "target_defs": "/components/schemas"
      }
    ],
    "patches": [
      {
        "file": "schemas/common.schema.json",
        "op": {
          "array": "replace",
          "node": "replace",
          "object": "merge"
        },
        "source": "/$defs/CommonConfig",
        "target": "/$defs/CommonConfig"
      }
    ],
    "prune_unreachable_defs": false
  },
  "mod2schema": {
    "json": {
      "indent": 2,
      "indent_type": "space",
      "minify": false
    },
    "key_namer": "none",
    "module": "../project",
    "package": "github.com/acme/project/pkg/config",
    "root_id": "https://example.com/schema.json",
    "type": "Config"
  },
  "schema": "schema.json",
  "schema2doc": {
    "description": "Generated by CI pipeline.",
    "footer": false,
    "format": "json",
    "hide_extra_keywords": false,
    "json": {
      "indent": 2,
      "indent_type": "space",
      "minify": false
    },
    "list_marker": "*",
    "mode": "all",
    "output": "<string>",
    "show_internal_keywords": false,
    "template": "list",
    "template_file": "templates/custom.md.gotmpl",
    "title": "schema reference",
    "wrap": 80,
    "yaml": {
      "comments": {
        "defaults": true,
        "descriptions": true,
        "enums": true,
        "example_format": "block",
        "examples": "scalar",
        "spacing": "compact",
        "titles": true
      },
      "indent": 2
    }
  },
  "schema2json": {
    "json": {
      "indent": 2,
      "indent_type": "space",
      "minify": false
    },
    "mode": "all",
    "output": "<string>"
  },
  "schema2yaml": {
    "mode": "all",
    "output": "<string>",
    "yaml": {
      "comments": {
        "defaults": true,
        "descriptions": true,
        "enums": true,
        "example_format": "block",
        "examples": "scalar",
        "spacing": "compact",
        "titles": true
      },
      "indent": 2
    }
  }
}
