{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kindA": { "const": "a" },
    "kindB": { "const": "b" },
    "tagX": { "type": "boolean" },
    "tagY": { "type": "boolean" }
  },
  "allOf": [
    {
      "oneOf": [
        { "required": ["kindA"] },
        { "required": ["kindB"] }
      ]
    },
    {
      "anyOf": [
        { "required": ["tagX"] },
        { "required": ["tagY"] }
      ]
    }
  ],
  "additionalProperties": false
}
