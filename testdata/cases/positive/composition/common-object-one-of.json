{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "match": { "type": "object" },
    "remove": { "type": "array" },
    "encrypt": { "type": "array" }
  },
  "required": ["match"],
  "oneOf": [
    { "required": ["remove"] },
    { "required": ["encrypt"] }
  ],
  "additionalProperties": false
}
