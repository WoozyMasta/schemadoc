package main

import (
	"crypto/sha256"
	"encoding/json"
	"errors"
	"fmt"
	"go/doc/comment"
	"os"
	"path"
	"reflect"
	"regexp"
	"strings"
	"unicode"

	"github.com/invopop/jsonschema"
	target {{ printf "%q" .PackagePath }}
)

// commentReferencePattern matches unresolved Go symbol references, not prose.
var commentReferencePattern = regexp.MustCompile(`\[((?:[\pL\pN_][\pL\pN_./-]*/)?[\pL_][\pL\pN_]*(?:\.[\pL_][\pL\pN_]*)*)\]`)

// errDefinitionNameCollision prevents emitting schemas with ambiguous definitions.
var errDefinitionNameCollision = errors.New("definition name collision")

// definitionNamer tracks ownership of generated names and the first collision.
type definitionNamer struct {
	seen map[string]reflect.Type // Named types registered under each definition name.
	err  error                   // First conflicting name, reported before schema output.
}

// applyCommentMode transforms only extracted Go comments before reflection.
func applyCommentMode(r *jsonschema.Reflector, mode string) error {
	switch mode {
	case "", "raw":
		return nil

	case "plain":
		for key, text := range r.CommentMap {
			r.CommentMap[key] = normalizeGoDocComment(text)
		}

		return nil

	default:
		return fmt.Errorf("unsupported comment mode %q", mode)
	}
}

// normalizeGoDocComment renders semantic blocks with one LF between them.
func normalizeGoDocComment(text string) string {
	text = strings.ReplaceAll(text, "\r\n", "\n")
	text = strings.ReplaceAll(text, "\r", "\n")
	var parser comment.Parser
	doc := parser.Parse(text)
	blocks := make([]string, 0, len(doc.Content))

	for _, block := range doc.Content {
		blocks = append(blocks, renderCommentBlock(block))
	}

	return strings.Join(blocks, "\n")
}

// renderCommentBlock preserves list and code structure without Markdown headings.
func renderCommentBlock(block comment.Block) string {
	switch block := block.(type) {
	case *comment.Paragraph:
		return renderCommentText(block.Text)

	case *comment.Heading:
		text := renderCommentText(block.Text)
		if text != "" && !strings.ContainsAny(text[len(text)-1:], ":.?!;") {
			text += ":"
		}
		return text

	case *comment.Code:
		return indentCommentLines(strings.TrimSuffix(block.Text, "\n"), "    ")

	case *comment.List:
		items := make([]string, 0, len(block.Items))
		for _, item := range block.Items {
			marker := "- "
			if item.Number != "" {
				marker = item.Number + ". "
			}

			var text strings.Builder
			for index, content := range item.Content {
				rendered := renderCommentBlock(content)

				if _, paragraph := content.(*comment.Paragraph); index == 0 && paragraph {
					text.WriteString(marker + rendered)
					continue
				}

				if index == 0 {
					text.WriteString(strings.TrimSpace(marker))
				}

				text.WriteString("\n" + indentCommentLines(rendered, "  "))
			}
			items = append(items, text.String())
		}

		return strings.Join(items, "\n")

	default:
		return ""
	}
}

// renderCommentText expands URL references and strips Go doc link syntax.
func renderCommentText(parts []comment.Text) string {
	var out strings.Builder

	for _, part := range parts {
		switch part := part.(type) {
		case comment.Plain:
			out.WriteString(commentReferencePattern.ReplaceAllString(string(part), "$1"))

		case comment.Italic:
			out.WriteString(string(part))

		case *comment.DocLink:
			out.WriteString(renderCommentText(part.Text))

		case *comment.Link:
			label := renderCommentText(part.Text)
			out.WriteString(label)

			if label != part.URL {
				out.WriteString(" (" + part.URL + ")")
			}
		}
	}

	return strings.Join(strings.Fields(out.String()), " ")
}

// indentCommentLines retains every code or continuation line, including blanks.
func indentCommentLines(text, indent string) string {
	return indent + strings.ReplaceAll(text, "\n", "\n" + indent)
}

func normalizeCommentKeys(r *jsonschema.Reflector, base, root string) {
	if r == nil || r.CommentMap == nil {
		return
	}

	base = strings.TrimSuffix(strings.TrimSpace(base), "/")
	root = strings.ReplaceAll(strings.TrimSpace(root), "\\", "/")
	root = strings.TrimSuffix(root, "/")
	if base == "" || root == "" {
		return
	}

	prefix := base + "/" + strings.TrimPrefix(root, "/")
	normalized := make(map[string]string, len(r.CommentMap))
	for key, value := range r.CommentMap {
		normalizedKey := strings.ReplaceAll(key, "\\", "/")
		if strings.HasPrefix(normalizedKey, prefix) {
			normalizedKey = base + strings.TrimPrefix(normalizedKey, prefix)
		}

		normalized[normalizedKey] = value
	}

	r.CommentMap = normalized
}

func toSeparatedLower(name string, separator rune) string {
	var out []rune
	for index, r := range name {
		if unicode.IsUpper(r) {
			if index > 0 && len(out) > 0 && out[len(out)-1] != separator {
				out = append(out, separator)
			}

			out = append(out, unicode.ToLower(r))
			continue
		}

		out = append(out, unicode.ToLower(r))
	}

	return string(out)
}

func applyKeyNamer(r *jsonschema.Reflector, mode string) error {
	if r == nil {
		return nil
	}

	switch strings.ToLower(strings.TrimSpace(mode)) {
	case "", "none":
		return nil
	case "snake":
		r.KeyNamer = func(name string) string {
			return toSeparatedLower(name, '_')
		}

	case "kebab":
		r.KeyNamer = func(name string) string {
			return toSeparatedLower(name, '-')
		}

	case "lower":
		r.KeyNamer = func(name string) string {
			return strings.ToLower(strings.TrimSpace(name))
		}

	default:
		return fmt.Errorf("unsupported key namer %q", mode)
	}

	return nil
}

func sanitizeTypeNamePart(value string) string {
	value = strings.TrimSpace(value)
	if value == "" {
		return ""
	}

	var out []rune
	for _, r := range value {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			out = append(out, unicode.ToLower(r))
			continue
		}

		if len(out) > 0 && out[len(out)-1] != '_' {
			out = append(out, '_')
		}
	}

	return strings.Trim(string(out), "_")
}

// applyTypeNamer installs request-local naming and collision tracking.
func applyTypeNamer(r *jsonschema.Reflector, targetPackagePath, mode string) (*definitionNamer, error) {
	if mode == "" {
		mode = "package"
	}

	if mode != "package" && mode != "full" {
		return nil, fmt.Errorf("unsupported type namer %q", mode)
	}

	namer := &definitionNamer{seen: make(map[string]reflect.Type)}

	if r == nil {
		return namer, nil
	}

	targetPackagePath = strings.TrimSpace(targetPackagePath)
	r.Namer = func(t reflect.Type) string {
		for t.Kind() == reflect.Pointer {
			t = t.Elem()
		}

		typeName := strings.TrimSpace(t.Name())
		if typeName == "" {
			return ""
		}
		name := typeName
		packagePath := t.PkgPath()

		if strings.TrimSpace(packagePath) != targetPackagePath {
			if mode == "full" && packagePath != "" {
				digest := sha256.Sum256([]byte(packagePath))
				name = fmt.Sprintf("%s_%x_%s", sanitizeFullTypeNamePart(packagePath), digest[:8], typeName)
			} else if packageName := sanitizeTypeNamePart(path.Base(strings.TrimSpace(packagePath))); packageName != "" {
				name = packageName + "_" + typeName
			}
		}

		if previous, exists := namer.seen[name]; exists {
			if previous != t && namer.err == nil {
				namer.err = fmt.Errorf("%w %q:\n  %s\n  %s\nrename one of the types/packages or use --type-namer full",
					errDefinitionNameCollision, name, qualifiedTypeName(previous), qualifiedTypeName(t))
			}
		} else {
			namer.seen[name] = t
		}

		return name
	}

	return namer, nil
}

// sanitizeFullTypeNamePart produces an ASCII import-path prefix without changing package mode.
func sanitizeFullTypeNamePart(value string) string {
	out := make([]byte, 0, len(value))

	for _, r := range value {
		if r >= 'A' && r <= 'Z' {
			r += 'a' - 'A'
		}

		if r >= 'a' && r <= 'z' || r >= '0' && r <= '9' {
			out = append(out, byte(r))
		} else if len(out) > 0 && out[len(out)-1] != '_' {
			out = append(out, '_')
		}
	}

	return strings.Trim(string(out), "_")
}

// qualifiedTypeName identifies a named type without package-base ambiguity.
func qualifiedTypeName(t reflect.Type) string {
	if t.PkgPath() == "" {
		return t.Name()
	}

	return t.PkgPath() + "." + t.Name()
}

func run() error {
	reflector := new(jsonschema.Reflector)
	namer, err := applyTypeNamer(reflector, {{ printf "%q" .PackagePath }}, {{ printf "%q" .TypeNamer }})
	if err != nil {
		return fmt.Errorf("apply type namer: %w", err)
	}
	if err := applyKeyNamer(reflector, {{ printf "%q" .KeyNamer }}); err != nil {
		return fmt.Errorf("apply key namer: %w", err)
	}

	if err := reflector.AddGoComments({{ printf "%q" .ModulePath }}, {{ printf "%q" .ModuleDir }}); err != nil {
		return fmt.Errorf("add go comments: %w", err)
	}
	normalizeCommentKeys(reflector, {{ printf "%q" .ModulePath }}, {{ printf "%q" .ModuleDir }})
	if err := applyCommentMode(reflector, {{ printf "%q" .Comments }}); err != nil {
		return fmt.Errorf("apply comment mode: %w", err)
	}

	schema := reflector.Reflect(&target.{{ .TypeName }}{})
	if namer.err != nil {
		return namer.err
	}
	if schema == nil {
		return errors.New("reflect schema: empty result")
	}
	if rootID := strings.TrimSpace({{ printf "%q" .RootID }}); rootID != "" {
		schema.ID = jsonschema.ID(rootID)
	}

	data, err := json.MarshalIndent(schema, "", "  ")
	if err != nil {
		return fmt.Errorf("marshal schema: %w", err)
	}

	data = append(data, '\n')
	if _, err := os.Stdout.Write(data); err != nil {
		return fmt.Errorf("write schema to stdout: %w", err)
	}

	return nil
}

func main() {
	if err := run(); err != nil {
		_, _ = fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
