<!-- Automatically generated file, do not modify! -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ html .Title }}</title>
  <style>
    :root {
      --bg: #f7f8fa;
      --fg: #24292f;
      --muted: #57606a;
      --border: #c6cdd5;
      --panel: #edf1f5;
      --code-bg: #edf1f5;
      --accent: #0969da;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 0;
      font-family:
        -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      color: var(--fg);
      background: var(--bg);
      line-height: 1.5;
    }
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.25rem 3rem;
    }
    h1, h2, h3 {
      line-height: 1.25;
      margin: 1.3rem 0 0.7rem;
    }
    h1 {
      margin-top: 0;
      font-size: 1.9rem;
    }
    h2 {
      font-size: 1.35rem;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--border);
    }
    h3 {
      font-size: 1.08rem;
      margin-top: 1.05rem;
    }
    p {
      margin: 0 0 0.8rem;
      overflow-wrap: anywhere;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover { text-decoration: underline; }
    .muted { color: var(--muted); }
    .panel {
      margin: 0.9rem 0 1rem;
      border: 1px solid var(--border);
      background: var(--panel);
      border-radius: 10px;
      padding: 0.85rem 0.95rem;
    }
    .toc ul, .attr-list, .paths {
      margin: 0.35rem 0 0;
      padding-left: 1.2rem;
    }
    .card {
      margin: 0.8rem 0 1rem;
      border: 1px solid var(--border);
      background: #fbfcfd;
      border-radius: 10px;
      padding: 0.85rem 0.95rem;
    }
    details.definition {
      margin: 0.9rem 0 1rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--panel);
      overflow: hidden;
    }
    details.definition > summary {
      list-style: none;
      cursor: pointer;
      padding: 0.7rem 0.9rem;
      user-select: none;
      border-bottom: 1px solid var(--border);
      font-weight: 600;
    }
    details.definition > summary::-webkit-details-marker {
      display: none;
    }
    details.definition > summary::before {
      content: "▾";
      margin-right: 0.45rem;
      color: var(--muted);
    }
    details.definition:not([open]) > summary::before {
      content: "▸";
    }
    .def-body {
      padding: 0.85rem 0.95rem 0.6rem;
      background: var(--bg);
    }
    .meta {
      margin: 0;
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.32rem 0.7rem;
      font-size: 0.94rem;
    }
    .meta dt {
      color: var(--muted);
      font-weight: 600;
    }
    .meta dd { margin: 0; }
    code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.08rem 0.35rem;
      font-size: 0.88em;
    }
    pre {
      margin: 0.7rem 0 0;
      background: #eef2f6;
      color: #1f2328;
      border-radius: 8px;
      border: 1px solid #c6cdd5;
      padding: 0.8rem 0.95rem;
      overflow: auto;
      font-size: 0.9rem;
    }
    pre code {
      background: transparent;
      border: 0;
      color: inherit;
      padding: 0;
    }
{{ if .ExampleDocument -}}
    .tok-key { color: #0b5fff; }
    .tok-string { color: #0a6e31; }
    .tok-number { color: #b35c00; }
    .tok-bool,
    .tok-null { color: #8a2be2; font-weight: 600; }
    .tok-punc { color: var(--muted); }
    .tok-comment { color: #6a737d; font-style: italic; }
{{ end -}}
    .attr-list pre {
      margin: 0.35rem 0 0;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0d1117;
        --fg: #e6edf3;
        --muted: #9da7b3;
        --border: #30363d;
        --panel: #161b22;
        --code-bg: #161b22;
        --accent: #58a6ff;
      }
      .card { background: #11161d; }
      pre {
        background: #0b0f14;
        color: #c9d1d9;
        border-color: #30363d;
      }
{{ if .ExampleDocument -}}
      .tok-key { color: #79c0ff; }
      .tok-string { color: #7ee787; }
      .tok-number { color: #ffa657; }
      .tok-bool,
      .tok-null { color: #d2a8ff; }
      .tok-punc { color: #8b949e; }
      .tok-comment { color: #8b949e; }
{{ end -}}
    }
    footer {
      margin-top: 2rem;
      padding: 0.9rem 1rem;
      border-top: 1px solid var(--border);
      background: var(--panel);
      border-radius: 8px;
      color: var(--muted);
      font-size: 0.9rem;
      text-align: center;
    }
    footer a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }
    footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <main>
    <h1>{{ html .Title }}</h1>
{{ if .Description -}}
    <div class="muted">{{ blockHTML .Description }}</div>
{{ end -}}

    <section class="panel">
      <dl class="meta">
{{ if ne .SourceSchema "(stdin)" -}}
        <dt>Source file</dt>
{{ if .SourceFileURL -}}
        <dd><a href="{{ html .SourceFileURL }}"><code>{{ html .SourceSchema }}</code></a></dd>
{{ else -}}
        <dd><code>{{ html .SourceSchema }}</code></dd>
{{ end -}}
{{ end -}}
{{ if .SchemaSourceURL -}}
        <dt>Source URL</dt>
        <dd><a href="{{ html .SchemaSourceURL }}">Raw schema URL</a></dd>
{{ end -}}
        <dt>Schema identifier</dt>
        <dd><code>{{ html .SchemaID }}</code></dd>
        <dt>JSON Schema version</dt>
        <dd><code>{{ html .SchemaDraft }}</code></dd>
        <dt>Version support</dt>
        <dd><code>{{ html .SchemaDraftSupport }}</code></dd>
        <dt>Root reference</dt>
        <dd><code>{{ html .RootRef }}</code></dd>
      </dl>
    </section>

    <section class="panel toc">
      <h2>Contents</h2>
      {{ tocHTML .Contents .ExampleFormat .ExampleDocument }}
    </section>

{{ range $index, $definition := .Definitions -}}
    <section>
      <details class="definition"{{ if eq $index 0 }} open{{ end }}>
        <summary>{{ html $definition.Name }}</summary>
        <div class="def-body" id="{{ headingAnchor $definition.Name }}">
{{ if $definition.Description -}}
      {{ blockHTML $definition.Description }}
{{ end -}}
{{ if $definition.Attributes -}}
      <div class="card">
        <ul class="attr-list">
{{ range $definition.Attributes -}}
          <li><strong>{{ html .Name }}:</strong> {{ attrHTML .Value }}</li>
{{ end -}}
        </ul>
      </div>
{{ end -}}

{{ if $definition.HasProperties -}}
{{ range $definition.Properties -}}
      <article class="card">
        <h3 id="{{ headingAnchor .Heading }}">{{ html .Heading }}</h3>
        <p><strong>Key:</strong> <code>{{ html .Name }}</code></p>
{{ if .Paths -}}
{{ if eq (len .Paths) 1 -}}
        <p><strong>Path:</strong> {{ inlineHTML (index .Paths 0) }}</p>
{{ else -}}
        <p><strong>Paths:</strong></p>
        <ul class="paths">
{{ range .Paths -}}
          <li>{{ inlineHTML . }}</li>
{{ end -}}
        </ul>
{{ end -}}
{{ end -}}
{{ if .Description -}}
        {{ blockHTML .Description }}
{{ end -}}
{{ if .Attributes -}}
        <ul class="attr-list">
{{ range .Attributes -}}
          <li><strong>{{ html .Name }}:</strong> {{ attrHTML .Value }}</li>
{{ end -}}
        </ul>
{{ end -}}
      </article>
{{ end -}}
{{ else -}}
      <p class="muted">No properties.</p>
{{ end -}}
        </div>
      </details>
    </section>
{{ end -}}

{{ if .ExampleDocument -}}
{{ $exampleHeading := printf "Example %s document" .ExampleFormat -}}
    <section>
      <h2 id="{{ headingAnchor $exampleHeading }}">{{ html $exampleHeading }}</h2>
      <pre><code id="example-code" class="lang-{{ html .ExampleFormat }}">{{ html .ExampleDocument }}</code></pre>
    </section>
{{ end -}}
{{ if and .FooterToolName .FooterToolURL -}}
    <footer>
      Generated with
      <a href="{{ html .FooterToolURL }}">{{ html .FooterToolName }}</a>
      version <code>{{ html .FooterVersion }}</code>
      commit <code>{{ html .FooterCommit }}</code>
    </footer>
{{ end -}}
{{ if .ExampleDocument -}}
  <script>
    (function () {
      const code = document.getElementById("example-code");
      if (!code) {
        return;
      }

      const format = (code.className || "").replace("lang-", "").trim().toLowerCase();
      const text = code.textContent || "";
      if (text.trim() === "") {
        return;
      }

      function escapeHTML(value) {
        return value
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }

      function appendToken(parts, kind, value) {
        if (value === "") {
          return;
        }
        if (!kind) {
          parts.push(escapeHTML(value));
          return;
        }
        parts.push('<span class="' + kind + '">' + escapeHTML(value) + '</span>');
      }

      function highlightJSON(input) {
        const re = /"(?:\\.|[^"\\])*"(?=\s*:)|"(?:\\.|[^"\\])*"|true|false|null|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|[{}\[\]:,]/g;
        let result = [];
        let index = 0;
        let match;
        while ((match = re.exec(input)) !== null) {
          appendToken(result, "", input.slice(index, match.index));
          const token = match[0];
          let kind = "tok-punc";
          if (token[0] === '"') {
            kind = token.endsWith(":") ? "tok-key" : "tok-string";
          } else if (token === "true" || token === "false") {
            kind = "tok-bool";
          } else if (token === "null") {
            kind = "tok-null";
          } else if (token[0] === "-" || (token[0] >= "0" && token[0] <= "9")) {
            kind = "tok-number";
          }
          appendToken(result, kind, token);
          index = re.lastIndex;
        }
        appendToken(result, "", input.slice(index));
        return result.join("");
      }

      function highlightYAML(input) {
        const lines = input.split("\n");
        let out = [];
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const commentIndex = line.indexOf("#");
          let base = line;
          let comment = "";
          if (commentIndex >= 0) {
            base = line.slice(0, commentIndex);
            comment = line.slice(commentIndex);
          }

          const keyMatch = base.match(/^(\s*-\s+|\s*)([A-Za-z0-9_.-]+)(\s*:\s*)(.*)$/);
          if (keyMatch) {
            out.push(
              escapeHTML(keyMatch[1]) +
              '<span class="tok-key">' + escapeHTML(keyMatch[2]) + '</span>' +
              '<span class="tok-punc">' + escapeHTML(keyMatch[3]) + '</span>' +
              highlightYAMLValue(keyMatch[4])
            );
          } else {
            out.push(highlightYAMLValue(base));
          }

          if (comment !== "") {
            out[out.length - 1] += '<span class="tok-comment">' + escapeHTML(comment) + '</span>';
          }
        }
        return out.join("\n");
      }

      function highlightYAMLValue(value) {
        const trimmed = value.trim();
        if (trimmed === "") {
          return escapeHTML(value);
        }

        if (/^(true|false)$/i.test(trimmed)) {
          return value.replace(trimmed, '<span class="tok-bool">' + escapeHTML(trimmed) + '</span>');
        }
        if (/^null$/i.test(trimmed)) {
          return value.replace(trimmed, '<span class="tok-null">' + escapeHTML(trimmed) + '</span>');
        }
        if (/^-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?$/.test(trimmed)) {
          return value.replace(trimmed, '<span class="tok-number">' + escapeHTML(trimmed) + '</span>');
        }
        if ((trimmed.startsWith('"') && trimmed.endsWith('"')) || (trimmed.startsWith("'") && trimmed.endsWith("'"))) {
          return value.replace(trimmed, '<span class="tok-string">' + escapeHTML(trimmed) + '</span>');
        }

        const listScalarMatch = value.match(/^(\s*-\s+)(.+)$/);
        if (listScalarMatch) {
          return (
            escapeHTML(listScalarMatch[1]) +
            '<span class="tok-string">' + escapeHTML(listScalarMatch[2]) + '</span>'
          );
        }

        const plainScalarMatch = value.match(/^(\s*)([^{}\[\],].*)$/);
        if (plainScalarMatch) {
          return (
            escapeHTML(plainScalarMatch[1]) +
            '<span class="tok-string">' + escapeHTML(plainScalarMatch[2]) + '</span>'
          );
        }

        return escapeHTML(value);
      }

      if (format === "json") {
        code.innerHTML = highlightJSON(text);
        return;
      }
      if (format === "yaml") {
        code.innerHTML = highlightYAML(text);
      }
    })();
  </script>
{{ end -}}
  </main>
</body>
</html>
<!-- Automatically generated file, do not modify! -->
